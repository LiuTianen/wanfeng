    "saveLocal": "readonly",
    "fetchGroups": "readonly",
    "fetchTags": "readonly",
    "renderGroupBar": "readonly",
    "saveToServer": "readonly",
    "updateOnServer": "readonly",
    "deleteOnServer": "readonly",
    "pinNote": "readonly",
    "unpinNote": "readonly",
    "updateStatus": "readonly",
    "render": "readonly",
    "buildCardHTML": "readonly",
    "toggleCalendar": "readonly",
    "renderCalendar": "readonly",
    "loadDiscover": "readonly",
    "openEditor": "readonly",
    "deleteNote": "readonly",
    "promptConnection": "readonly",
    "promptSettings": "readonly",
    "setBackground": "readonly",
    "applyBackground": "readonly",
    "renderAdminPanel": "readonly",
    "resizeTimer": "writable"

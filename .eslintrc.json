{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-undef": "error",
    "no-redeclare": ["error", { "builtinGlobals": false }],
    "no-unused-vars": "off"
  },
  "globals": {
    "STORAGE_KEY": "readonly",
    "API_KEY_STORAGE": "readonly",
    "API_BASE": "readonly",
    "safeTags": "readonly",
    "openLightbox": "readonly",
    "esc": "readonly",
    "toast": "readonly",
    "genId": "readonly",
    "getApiKey": "readonly",
    "apiFetch": "readonly",
    "uploadImage": "readonly",
    "adminApiFetch": "readonly",
    "notes": "writable",
    "editId": "writable",
    "apiKey": "writable",
    "activeGroup": "writable",
    "groups": "writable",
    "allTags": "writable",
    "activeTag": "writable",
    "showCalendar": "writable",
    "calYear": "writable",
    "calMonth": "writable",
    "calSelectedDate": "writable",
    "currentView": "writable",
    "currentKeyIsAdmin": "writable",
    "listEl": "readonly",
    "searchEl": "readonly",
    "discoverView": "readonly",
    "discoverList": "readonly",
    "discoverFooter": "readonly",
    "headerBtns": "readonly",

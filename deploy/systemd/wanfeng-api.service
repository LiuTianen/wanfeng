[Unit]
Description=晚风笔记 API 服务
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wanfeng/server
Environment=WANFENG_DATA_DIR=/var/lib/wanfeng
ExecStart=/var/www/wanfeng/server/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
